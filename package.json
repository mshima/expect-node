{
  "name": "expect-node",
  "version": "0.3.1",
  "description": "node:test with the expect and mock API of Jest and Vitest, its coverage of subprocesses and workers included",
  "keywords": [
    "node:test",
    "test",
    "expect",
    "jest",
    "vitest",
    "mock",
    "coverage",
    "typescript"
  ],
  "homepage": "https://github.com/mshima/expect-node",
  "bugs": "https://github.com/mshima/expect-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mshima/expect-node.git"
  },
  "license": "MIT",
  "author": "Marcelo Shima <marceloshima@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "bin": {
    "exnode": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix && prettier --write .",
    "prettier-check": "prettier --check .",
    "prepare": "npm run build",
    "test": "node src/cli.ts --coverage"
  },
  "dependencies": {
    "expect": "^30.5.2",
    "jest-mock": "^30.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jest-snapshot": "^30.5.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "peerDependencies": {
    "jest-snapshot": "^30.0.0"
  },
  "peerDependenciesMeta": {
    "jest-snapshot": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
